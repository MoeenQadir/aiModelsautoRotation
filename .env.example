# Moon AI Auto Router - environment variables template
# Copy this file to .env and fill in your keys:  cp .env.example .env
# NEVER commit .env (it is gitignored).

# --- Groq (optional; uncomment the two Groq deployments in
#     litellm-config.yaml after adding real keys here) ---
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=

# --- Cerebras (free tier) ---
CEREBRAS_API_KEY=

# --- OpenRouter (free models, aggregator/fallback) ---
OPENROUTER_API_KEY=

# --- Google Gemini ---
GEMINI_API_KEY=

# --- GitHub Models (optional; needs a PAT with "models" permission) ---
GITHUB_TOKEN=

# --- Router master key (this is the key OpenCode uses) ---
LITELLM_MASTER_KEY=sk-moon-router-2026-local
