[TEMPLATE]
# Moon AI Auto Router - environment variables template
# Copy this file to .env and fill in your keys:  cp .env.example .env
# NEVER commit .env (it is gitignored).
# Status key verified against live provider APIs: 2026-10-03

# ============================================================================
# ACTIVE & VERIFIED (all serving requests as of 2026-10-03)
# ============================================================================

# --- Groq, 2-key rotation (console.groq.com/keys) ---
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# --- Cerebras free tier (cloud.cerebras.ai) ---
CEREBRAS_API_KEY=

# --- OpenRouter (free models, aggregator/fallback; openrouter.ai/keys) ---
OPENROUTER_API_KEY=

# --- Google Gemini (aistudio.google.com/apikey) ---
# Must be an API KEY starting with "AIza..." (~39 chars).
# OAuth2 access tokens (starting with "AQ.A...", e.g. from Gemini CLI /
# gcloud auth) are NOT accepted by the Gemini API and cause:
#   401 UNAUTHENTICATED - ACCESS_TOKEN_TYPE_UNSUPPORTED
GEMINI_API_KEY=

# --- Mistral (console.mistral.ai - free "Experiment" tier).
#     Enables: mistral/codestral-latest in the coding group ---
MISTRAL_API_KEY=

# --- Cloudflare Workers AI (dash.cloudflare.com -> Workers AI; free
#     10k neurons/day). BOTH values required; LiteLLM builds the endpoint
#     from CLOUDFLARE_ACCOUNT_ID. ---
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# ============================================================================
# PARKED - key valid, deployment disabled for an account-level reason
# ============================================================================

# --- SambaNova (cloud.sambanova.ai). API key is SET and VALID, but on
#     2026-10-03 inference returned HTTP 402 PAYMENT_METHOD_REQUIRED - the
#     account needs a payment method on file at
#     https://cloud.sambanova.ai/plans/billing (the free tier is not charged).
#     Add one, then uncomment the block in litellm-config.yaml. ---
# SAMBANOVA_API_KEY=  (already set in .env)

# ============================================================================
# PENDING - waiting on you; each has a commented NEEDS block in
# litellm-config.yaml at its intended priority position. Uncomment the
# config block once the key lands here, then:
#   docker compose up -d --force-recreate
# ============================================================================

# --- Together AI (api.together.ai - free tier).
#     Enables: together_ai/Llama-3.3-70B-Instruct-Turbo-Free  [coding] ---
# TOGETHER_API_KEY=

# --- Fireworks AI (fireworks.ai - free trial credits).
#     Enables: fireworks_ai/llama-v3p1-70b-instruct  [coding] ---
# FIREWORKS_API_KEY=

# --- NVIDIA NIM (build.nvidia.com - free developer tier).
#     Enables: nvidia_nim/meta/llama-3.1-70b-instruct  [coding] ---
# NVIDIA_API_KEY=

# --- Qwen / Alibaba DashScope international (bailian.console.alibabacloud.com
#     - free quota). Enables: qwen2.5-coder-32b-instruct  [coding] ---
# QWEN_API_KEY=

# ============================================================================
# SET BUT BLOCKED UPSTREAM (not a config problem)
# ============================================================================

# --- GitHub Models: token is set, but models.github.ai/inference still
#     returns a non-JSON "OK" body for this token (re-verified 2026-10-03).
#     Regenerate the PAT (fine-grained, models: read), then test; uncomment
#     the block in litellm-config.yaml if it starts returning JSON. ---
GITHUB_TOKEN=

# ============================================================================
# Router master key (this is the key OpenCode uses) - CHANGE THIS
# ============================================================================
LITELLM_MASTER_KEY=sk-moon-router-2026-local
